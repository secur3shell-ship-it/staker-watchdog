PORT=3000
HOST=127.0.0.1
RPC_URL=https://api.mainnet-beta.solana.com
DATABASE_PATH=.data/staker-watchdog.sqlite
POLL_INTERVAL_MS=300000
FREE_RATE_LIMIT=120
PAID_RATE_LIMIT=6000
# Comma-separated key:tier entries. Keys must be at least 32 characters:
#   openssl rand -hex 24
STAKER_API_KEYS=
# Behind a reverse proxy: number of proxy hops (e.g. 1) or proxy addresses/subnets.
# Leave empty when clients connect directly. "true" is rejected (spoofable).
TRUST_PROXY=
# Live-update (SSE) stream limits
SSE_MAX_CONNECTIONS=1000
SSE_MAX_CONNECTIONS_PER_CLIENT=10
# Optional webhook receiving JSON alert POSTs (retried until delivered)
ALERT_WEBHOOK_URL=
# Signs webhook requests (X-Staker-Watchdog-Signature); strongly recommended with a URL
ALERT_WEBHOOK_SECRET=
